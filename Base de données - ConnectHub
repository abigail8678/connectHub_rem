//Table 'interets_utilisateurs'
CREATE TABLE interets_utilisateurs (
    user_id INT,
    interet_id INT,
    PRIMARY KEY (user_id, interet_id),
    FOREIGN KEY (user_id) REFERENCES utilisateurs(id) ON DELETE CASCADE,
    FOREIGN KEY (interest_id) REFERENCES interets(id) ON DELETE CASCADE
);
